<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient">

    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Modern Unique Animated Splash Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/splashOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/splash_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Ambient decorative background glowing orbs -->
        <View
            android:id="@+id/bgOrbTop"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="-60dp"
            android:background="@drawable/splash_floating_orb"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/bgOrbBottom"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_marginBottom="-90dp"
            android:layout_marginStart="-90dp"
            android:background="@drawable/splash_floating_orb"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Center Hero Group -->
        <LinearLayout
            android:id="@+id/splashCenterGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/splashBottomGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.44">

            <!-- Logo Ring and Frosted Pod -->
            <FrameLayout
                android:id="@+id/logoContainer"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center">

                <!-- Pulsing outer ring -->
                <View
                    android:id="@+id/pulseRing"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:background="@drawable/splash_outer_ring" />

                <!-- Elevated Frosted Card -->
                <FrameLayout
                    android:id="@+id/logoCard"
                    android:layout_width="144dp"
                    android:layout_height="144dp"
                    android:layout_gravity="center"
                    android:background="@drawable/splash_card_bg"
                    android:elevation="8dp"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/overlayLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:contentDescription="জ্ঞান সহায়তা লোগো"
                        android:scaleType="fitCenter" />
                </FrameLayout>
            </FrameLayout>

            <!-- Pill Badge: New Curriculum 2026 -->
            <TextView
                android:id="@+id/splashBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/splash_badge_bg"
                android:text="✨ নতুন শিক্ষাক্রম ২০২৬ • সম্পূর্ণ গাইড"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- App Title with Bangla Typography & Drop Shadow -->
            <TextView
                android:id="@+id/splashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="জ্ঞান সহায়তা"
                android:textColor="@color/splash_title_color"
                android:textSize="32sp"
                android:textStyle="bold"
                android:shadowColor="#26000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="6" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/splashSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="সপ্তম শ্রেণী • অল সাবজেক্ট গাইড"
                android:textColor="@color/splash_sub_color"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

            <!-- Motivational Tagline -->
            <TextView
                android:id="@+id/splashTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="ডিজিটাল শিক্ষায় আগামীর প্রস্তুতি"
                android:textColor="#0369A1"
                android:textSize="13sp"
                android:alpha="0.85" />
        </LinearLayout>

        <!-- Bottom Status & Loading Section -->
        <LinearLayout
            android:id="@+id/splashBottomGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Sleek Loading Bar Container -->
            <ProgressBar
                android:id="@+id/splashProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="160dp"
                android:layout_height="5dp"
                android:indeterminate="true"
                android:progressDrawable="@drawable/splash_progress_horizontal" />

            <TextView
                android:id="@+id/splashLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="বই ও পাঠ্যসূচি প্রস্তুত হচ্ছে..."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:shadowColor="#40000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/splashFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="জ্ঞান ও মেধার অনন্য বিকাশ • অফলাইন সংস্করণ"
                android:textColor="#CCF0F9FF"
                android:textSize="11sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>